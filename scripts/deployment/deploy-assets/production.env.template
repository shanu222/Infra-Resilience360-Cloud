##
## Paste into `.env` on the EC2 host (chmod 600). Never commit secrets.
##

NODE_ENV=production
PORT=10000

## MongoDB Atlas (mongoose) — include database name in the path (e.g. /net360), not only `/?appName=…`
MONGODB_URI=mongodb+srv://USER:PASS@CLUSTER/net360?retryWrites=true&w=majority&appName=Cluster0
## Optional tuning — see server/mongoConnection.mjs
# MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
# MONGO_BUFFER_TIMEOUT_MS=20000
# MONGO_MAX_POOL_SIZE=40
# MONGO_RECONNECT_MIN_MS=2000
# MONGO_RECONNECT_MAX_MS=60000

## JWT — match what your login routes expect (often JWT_SECRET).
JWT_SECRET=

## AWS S3 media (CMS + community photos + streamed admin uploads)
AWS_REGION=us-east-1
S3_MEDIA_BUCKET=your-net360-media-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
## Optional STS / IRSA temporary creds:
# AWS_SESSION_TOKEN=

## Public URL prefix for CDN / virtual-host-style GETs — MUST match your bucket/hosting layout.
## Examples:
##   Virtual-hosted regional: https://your-bucket.s3.us-east-1.amazonaws.com
##   Static website / CDN: https://cdn.example.com
##   Alias domain: https://media.example.com
S3_PUBLIC_BASE_URL=https://YOUR_BUCKET.s3.YOUR_REGION.amazonaws.com

## Optional multipart tuning
# CMS_UPLOAD_MAX_MB=300
# R360_CMS_UPLOAD_STREAM=1          # staging copy → canonical key (recommended on EC2)
# S3_UPLOAD_ACL=
# S3_UPLOAD_CACHE_CONTROL=public, max-age=31536000

## Reverse proxy hints (recommended when TLS terminates at Nginx)
PUBLIC_API_BASE_URL=https://api.infraresilience.org

## Credentialed browser CORS (Vercel + previews)
CORS_ORIGIN=https://www.infraresilience.org
# CORS_ORIGINS=https://www.infraresilience.org,https://www.infraresilience.org

## Admin key (mirror in VITE_ADMIN_API_KEY during Vercel builds)
ADMIN_API_KEY=

## Readiness probe: set to `1` if load balancer should refuse traffic without S3 creds configured
# HEALTH_READY_REQUIRE_S3=1

## Logging / AI keys / other — keep from your existing .env.example

