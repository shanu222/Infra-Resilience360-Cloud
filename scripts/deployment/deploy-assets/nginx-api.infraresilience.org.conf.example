# Example site config for infra-resilience360-cloud-production.up.railway.app → Node on 127.0.0.1:10000
# Copy to the server (e.g. /etc/nginx/sites-available/) and enable with a symlink under sites-enabled.
# Then: sudo nginx -t && sudo systemctl reload nginx

# CORS: let Node (server/middleware/corsConfig.mjs) set credentialed headers.
# Do NOT add `add_header Access-Control-Allow-Origin *` here — browsers reject `*`
# when the SPA uses credentialed fetch. Proxy OPTIONS to Node (no redirect on preflight).

server {
    listen 80;
    server_name infra-resilience360-cloud-production.up.railway.app;

    location / {
        proxy_pass http://127.0.0.1:10000;
        proxy_http_version 1.1;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
