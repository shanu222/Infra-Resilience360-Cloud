##
## Railway production template (cloud-only runtime media)
## Never commit real secrets.
##

NODE_ENV=production
PORT=10000
OPENAI_API_KEY=

# Cloudflare R2 runtime media base URL (backend proxies /storage/content/* to this base).
MEDIA_BASE_URL=

# Optional fallback path for local development only.
MEDIA_ROOT=storage/content

# Frontend/backend public API origins
API_BASE_URL=https://infra-resilience360-cloud-production.up.railway.app
PUBLIC_API_BASE_URL=https://infra-resilience360-cloud-production.up.railway.app
VITE_API_BASE_URL=https://infra-resilience360-cloud-production.up.railway.app

# Cloudflare R2 credentials/config
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Keep only if required by active auth flows.
JWT_SECRET=

