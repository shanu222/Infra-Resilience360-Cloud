# Cloud media policy: keep module structure + metadata/readme, ignore runtime binaries
storage/content/**/images/**
storage/content/**/videos/**
storage/content/**/pdfs/**
storage/content/**/audio/**
!storage/content/**/metadata.json
!storage/content/**/README.md

# Android release signing secrets (never commit)
key.properties
keystore.properties
*.jks
*.keystore
