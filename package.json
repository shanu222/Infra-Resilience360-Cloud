{
  "name": "resilience360",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions"
  ],
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --port 5173 --strictPort",
    "frontend": "vite --config frontend/vite.config.ts --port 5173 --strictPort",
    "dev:full": "node scripts/check-dev-ports.mjs && concurrently \"npm run server\" \"npm run dev\"",
    "start": "node backend/server.js",
    "start:admin": "node scripts/utilities/admin-static-server.mjs",
    "server": "node backend/index.mjs",
    "backend": "node backend/index.mjs",
    "build": "vite build --config frontend/vite.config.ts",
    "build:backend": "node --check backend/index.mjs",
    "build:typecheck": "tsc -b frontend/tsconfig.json",
    "postinstall": "echo Production install completed",
    "media:migrate:enterprise": "node scripts/enterprise-media-migration.mjs",
    "media:centralize": "node scripts/centralize-large-media.mjs",
    "build:admin": "vite build --config frontend/vite.config.ts",
    "build:pwa": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview --config frontend/vite.config.ts",
    "material-hubs:sync": "node scripts/sync-material-hubs.mjs",
    "material-hubs:rebuild": "npm run material-hubs:sync",
    "disaster-dashboard:sync": "node scripts/sync-disaster-dashboard.mjs",
    "disaster-dashboard:rebuild": "npm run disaster-dashboard:sync",
    "disaster-subtitles": "node scripts/generate-disaster-subtitles.mjs",
    "optimize:hero-webp": "node scripts/encode-hero-webp.mjs",
    "optimize:release-backgrounds": "node scripts/optimize-release-backgrounds.mjs",
    "android:icons": "node scripts/generate-android-icons.mjs",
    "build:debug": "vite build --config frontend/vite.config.ts --mode development"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@capacitor/app": "^8.0.0",
    "@google/generative-ai": "^0.24.1",
    "@tailwindcss/vite": "^4.1.12",
    "@turf/boolean-point-in-polygon": "^7.3.4",
    "@turf/centroid": "^7.3.4",
    "@vitejs/plugin-react": "^5.1.1",
    "arabic-persian-reshaper": "^1.0.1",
    "axios": "^1.15.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "docx": "^9.5.3",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "geotiff": "^3.0.5",
    "html2canvas": "^1.4.1",
    "iconv-lite": "^0.6.3",
    "jspdf": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.7.0",
    "mammoth": "^1.11.0",
    "motion": "^12.23.24",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "openai": "^6.22.0",
    "pdf-parse": "^2.4.5",
    "pino": "^10.3.1",
    "react": "^19.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "^19.2.0",
    "react-globe.gl": "^2.37.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.13.0",
    "recharts": "^3.9.0",
    "tailwindcss": "^4.1.12",
    "ts-node": "^10.9.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@eslint/js": "^9.39.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
