# Infra Resilience360 - production cloud environment
# Vercel (frontend) -> Railway (backend API) -> Cloudflare R2 (runtime media)

NODE_ENV=production
PORT=10000
OPENAI_API_KEY=

# Backend media proxy target (Cloudflare R2 public base for runtime media).
# Backend serves /storage/content/* by proxying this base URL in production.
MEDIA_BASE_URL=

# Optional local fallback media root (not used when MEDIA_BASE_URL is set).
MEDIA_ROOT=storage/content

# Live earthquake feed (Railway backend)
EARTHQUAKE_PROVIDER=USGS
EARTHQUAKE_REFRESH_SECONDS=60
USGS_FEED=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/all_day.geojson
EMSC_ENABLED=false
GFZ_ENABLED=false
ISC_ENABLED=false
NDMA_ENABLED=false

# AI orchestration (OpenAI → Gemini → OpenRouter fallback chain)
AI_PROVIDER_ORDER=openai,gemini,openrouter
AI_TIMEOUT_MS=45000
AI_MAX_RETRIES=3
AI_FALLBACK_ENABLED=true
OPENROUTER_MODELS=google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free,meta-llama/llama-3.3-70b-instruct:free,nousresearch/hermes-3-405b:free,qwen/qwen3-coder-480b-a35b:free
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Public API origin (used by frontend build/runtime integration)
API_BASE_URL=https://infra-resilience360-cloud-production.up.railway.app
PUBLIC_API_BASE_URL=https://infra-resilience360-cloud-production.up.railway.app
VITE_API_BASE_URL=https://infra-resilience360-cloud-production.up.railway.app

# Cloudflare R2 credentials/config (for integrations and future signed operations)
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=

# Keep only if auth flows require JWT signing.
JWT_SECRET=
