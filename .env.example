# =============================================================================
# Resilience360 — environment variables (copy to .env, never commit .env)
# =============================================================================
# Quick start (local full stack):
#   cp .env.example .env
#   npm install
#   npm run dev:full
# API default port: 10000 (see server/index.mjs). Vite proxies /api → :10000.
# =============================================================================

# --- Core server ---
NODE_ENV=development
PORT=10000
MEDIA_ROOT=storage/content

# --- Database (CMS, page config, section content) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER/resilience360
MONGODB_DB=resilience360
# MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
# MONGO_RECONNECT_MIN_MS=2000
# MONGO_RECONNECT_MAX_MS=60000
# MONGO_STARTUP_WAIT_MS=2500

# --- Admin / security ---
ADMIN_API_KEY=change-me-in-production
JWT_SECRET=change-me-in-production
# COMMUNITY_ISSUES_ADMIN_TOKEN=
# INFRA_MODELS_ADMIN_TOKEN=
# ADMIN_SERVICE_MODE=false

# --- AWS S3 (server-side CMS sync, presign, uploads) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_MEDIA_BUCKET=pak-population-data
# S3_PUBLIC_BASE_URL=https://pak-population-data.s3.amazonaws.com
# AWS_SESSION_TOKEN=
# S3_SYNC_PREFIX=resilience360/
# S3_MAX_SOCKETS=320
# S3_MAX_FREE_SOCKETS=96
# S3_SOCKET_ACQUIRE_WARN_MS=20000
# S3_REQUEST_TIMEOUT_MS=60000
# S3_DISASTER_MEDIA_PRESIGN_SECONDS=900

# --- AI providers (server) ---
AI_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_API_KEYS=key1,key2
OPENAI_VISION_MODEL=gpt-4o-mini
# OPENAI_VISION_FALLBACK_MODELS=gpt-4o-mini,gpt-4.1-mini,gpt-4o
OPENAI_FALLBACK_TO_HUGGINGFACE=true
# ALLOW_MISSING_OPENAI_KEY=true
# AI_DEBUG_RAW=0
# AI_CHAT_TIMEOUT_MS=45000
# AI_PROVIDER_REQUEST_TIMEOUT_MS=12000
# AI_IMAGE_TIMEOUT_MS=75000
# AI_IMAGE_CONCURRENCY=2
# AI_OPENAI_REQUEST_TIMEOUT_MS=15000

GEMINI_API_KEY=

HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
HUGGINGFACE_VISION_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-dev

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=Resilience360

# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# COST_ESTIMATOR_OPENAI_API_KEYS=
# COST_ESTIMATOR_OPENAI_API_KEY=
# COST_ESTIMATOR_INFERENCE_SEED=42
# COST_ESTIMATOR_DEBUG_DEFAULT=false

# --- CORS / public URLs (server) ---
# CORS_ORIGIN=https://www.infraresilience.org
# CORS_ORIGINS=https://www.infraresilience.org,https://preview.infraresilience.org
# CORS_ALLOW_ALL_ORIGINS=0
# CORS_OPEN_MOBILE=0
PUBLIC_API_BASE_URL=https://api.infraresilience.org
# API_BASE_URL=

# --- External feeds (server defaults exist) ---
# NDMA_ADVISORIES_URL=https://ndma.gov.pk/advisories
# NDMA_SITREPS_URL=https://ndma.gov.pk/sitreps
# NDMA_PROJECTIONS_URL=https://ndma.gov.pk/projection-impact-list_new
# PMD_RSS_URL=https://cap-sources.s3.amazonaws.com/pk-pmd-en/rss.xml
# PMD_HOME_URL=https://www.pmd.gov.pk/en
# GLOBAL_EARTHQUAKE_FEED_URL=
# GLOBAL_EARTHQUAKE_FEED_URL_BACKUP=
# EMSC_EARTHQUAKE_FEED_URL=
# GLOBAL_BUILDING_ATLAS_WFS_URL=
# GLOBAL_BUILDING_ATLAS_WFS_LAYERS=GBA:ODbLPolygon,GBA.ODbLPolygon,GBA:Polygon,GBA.Polygon
# GLOBAL_BUILDING_ATLAS_ROOT=./GlobalBuildingAtlas-main

# --- Email recovery (optional) ---
# RECOVERY_EMAIL_PROVIDER=resend
# RECOVERY_FROM_EMAIL=
# RECOVERY_FROM_NAME=Resilience360 Recovery
# RESEND_API_KEY=
# BREVO_API_KEY=
# RECOVERY_RATE_LIMIT_WINDOW_MS=900000
# RECOVERY_RATE_LIMIT_MAX_REQUESTS=6

# --- CMS / cache / debug (server) ---
# CMS_SYNC_ENABLED=false
# CMS_READ_CACHE=true
# CMS_READ_CACHE_TTL_SECONDS=60
# INFRA_MODELS_GIT_SYNC_ENABLED=false
# INFRA_MODELS_GIT_SYNC_BRANCH=main
# EARTHQUAKE_ALERT_NOTIFIER_ENABLED=false
# EARTHQUAKE_ALERT_MAGNITUDE_THRESHOLD=5
# EARTHQUAKE_ALERT_POLL_INTERVAL_MS=120000
# R360_REQUEST_LOG=0
# R360_VERBOSE_HTTP=0
# R360_DEBUG_ROUTES=0

# =============================================================================
# Vite / frontend (prefix VITE_ — baked in at build time)
# =============================================================================

# API origin single source of truth for local dev
VITE_API_BASE_URL=http://localhost:10000
# VITE_API_URL=   # legacy alias of VITE_API_BASE_URL

VITE_SITE_URL=https://www.infraresilience.org
# VITE_BASE_PATH=/

# Capacitor production build (set by npm run build:capacitor)
# VITE_CAPACITOR=1
# VITE_PORTAL_BASE_URL=https://www.infraresilience.org
# VITE_PORTAL_STATIC_BASE_URL=https://www.infraresilience.org

VITE_S3_MEDIA_BUCKET=pak-population-data
VITE_ADMIN_API_KEY=change-me-in-production
# VITE_ADMIN_SERVICE_MODE=true

VITE_NDMA_ADVISORIES_URL=https://ndma.gov.pk/advisories
VITE_NDMA_SITREPS_URL=https://ndma.gov.pk/sitreps
VITE_NDMA_PROJECTIONS_URL=https://ndma.gov.pk/projection-impact-list_new
VITE_PMD_RSS_URL=https://cap-sources.s3.amazonaws.com/pk-pmd-en/rss.xml

# =============================================================================
# Scripts only (npm run cms:*, media-health-check, etc.)
# =============================================================================
# MONGODB_URI=   (same as server)
# CMS_API_URL=http://127.0.0.1:10000
# API_URL=http://127.0.0.1:10000
# ADMIN_API_KEY=
# S3_BUCKET=pak-population-data
# S3_REGION=eu-north-1
# UPLOAD_MISSING=0
# PROXY_SAMPLE_LIMIT=300
